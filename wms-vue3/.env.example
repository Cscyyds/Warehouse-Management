# PageAgent 模型请求统一通过 nuomi_wms 后端。
VITE_PAGE_AGENT_ENABLED=false
# Vite 开发服务器统一代理普通 API 与 AI 后端（含语音识别 WebSocket）。
VITE_API_PROXY_TARGET=https://www.aster-mindlink.cn
# 小程序 AI 工作台对应的 Coze-Connect 服务（会话、SSE、文件、ASR）。
VITE_AI_PROXY_TARGET=https://www.aster-mindlink.cn:7779
# PDF 审核工作台云端兜底地址（导出 xlsx / 审核快照的粘性寻址源）。
# 留空 = 仅走本地 Coze_Connect 网关（vite 代理 → 127.0.0.1:8001），调试环境推荐留空。
VITE_PDF_API_BASE=https://www.aster-mindlink.cn:7779
