# PageAgent 模型请求统一通过 nuomi_wms 后端。
VITE_PAGE_AGENT_ENABLED=false
# Vite 开发服务器统一代理普通 API 与 AI 后端（含语音识别 WebSocket）。
VITE_API_PROXY_TARGET=https://www.aster-mindlink.cn
# 小程序 AI 工作台对应的 Coze-Connect 服务（会话、SSE、文件、ASR）。
VITE_AI_PROXY_TARGET=https://www.aster-mindlink.cn:7779
# PDF 审核工作台（上传/工作流/快照/知识库导入，Coze_Connect 网关）：
# VITE_PDF_PROXY_TARGET = vite dev 代理的转发目标，调试环境推荐本地网关。
VITE_PDF_PROXY_TARGET=http://127.0.0.1:8001
# VITE_PDF_API_BASE = PDF 链路云端兜底地址（粘性寻址源）。
# 留空 = 仅走本地（同源 vite 代理 → VITE_PDF_PROXY_TARGET），不接线上，调试推荐留空；
# 连云端时填 https://www.aster-mindlink.cn:7779，并把 VITE_PDF_PROXY_TARGET 改为同一地址。
VITE_PDF_API_BASE=
# 条码打印 / 打印任务（scanner 扫码枪后端，独立服务）：
# VITE_SCANNER_API_BASE_URL = 前端 axios 实例的 baseURL。开发用相对路径 /scanner-api，
# 由 vite dev 代理转发（同源 → 不触发 CORS 预检）；生产若直连线上，须填完整地址
# https://www.aster-mindlink.cn:7780，并确认该服务的 CORS 白名单已放行前端所在域名
# （当前线上只放行 http://localhost:3000）。线上只对外开 7780（nginx → 本机 8010），
# 8010 端口外部不可达。
VITE_SCANNER_API_BASE_URL=/scanner-api
# VITE_SCANNER_PROXY_TARGET = vite dev 代理 /scanner-api 的转发目标。
VITE_SCANNER_PROXY_TARGET=https://www.aster-mindlink.cn:7780

# 打印客户端安装包（精臣打印服务 / USB 驱动 / 芯烨打印代理）的云下载地址前缀。
# 百度云 BOS 桶地址，与 nuomi_wms/.env 的 BAIDU_BOS_ENDPOINT 同值（同一个桶）；留空则用内置默认域名。
# 注意：这些安装包已不再放 public/downloads/，必须保证桶内对象为公共读，否则用户点下载会拿到 403。
VITE_DOWNLOAD_BASE_URL=https://nuomiwms.gz.bcebos.com
