# PageAgent 模型请求统一通过 nuomi_wms 后端。
VITE_PAGE_AGENT_ENABLED=false
# Vite 开发服务器统一代理普通 API 与 AI 后端（含语音识别 WebSocket）。
VITE_API_PROXY_TARGET=https://www.aster-mindlink.cn
# 小程序 AI 工作台对应的 Coze-Connect 服务（会话、SSE、文件、ASR）。
VITE_AI_PROXY_TARGET=https://www.aster-mindlink.cn:7779
# PDF 审核工作台（上传/工作流/快照/知识库导入，Coze_Connect 网关）：
# VITE_PDF_PROXY_TARGET = vite dev 代理的转发目标，调试环境推荐本地网关。
VITE_PDF_PROXY_TARGET=http://127.0.0.1:8001
# VITE_PDF_API_BASE = PDF 链路云端兜底地址（粘性寻址源）。
# 留空 = 仅走本地（同源 vite 代理 → VITE_PDF_PROXY_TARGET），不接线上，调试推荐留空；
# 连云端时填 https://www.aster-mindlink.cn:7779，并把 VITE_PDF_PROXY_TARGET 改为同一地址。
VITE_PDF_API_BASE=
