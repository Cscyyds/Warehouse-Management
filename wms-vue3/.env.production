VITE_API_BASE_URL=/
VITE_API_PROXY_TARGET=https://www.aster-mindlink.cn
VITE_PAGE_AGENT_ENABLED=true
VITE_PAGE_AGENT_API_BASE_URL=/api/v1/page-agent
# 语音识别走当前域名的 /api/v1/asr/doubao/stream（WebSocket 流式），由反向代理转发到 AI 后端。
# PDF 审核工作台云端兜底地址（工作流云函数在云端建任务，本地 8001 查不到其快照）。
VITE_PDF_API_BASE=https://www.aster-mindlink.cn:7779
# 条码打印 / 打印任务（scanner 扫码枪后端，独立服务，线上只对外的 7780）：
# 必须走同源前缀 /scanner-api，由 nginx 转发到 127.0.0.1:8010（见 nginx-asterwms.conf 的
# location ^~ /scanner-api/）。不能留空——留空会退回代码里的默认
# http://127.0.0.1:8010，那是「访问者自己电脑」的 8010，线上必然 Network Error。
# 也不建议填 https://www.aster-mindlink.cn:7780：线上 scanner 的 CORS 白名单没有
# www.asterwms.cn，跨域预检会被拦。
VITE_SCANNER_API_BASE_URL=/scanner-api
