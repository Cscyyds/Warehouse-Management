VITE_API_BASE_URL=/
# 本地联调：天心跳接数据只落在本地 wms_ai 库，指回线上会让天心四单据列表 total=0。
# 改这里后必须重启 vite 才生效（.env 不热重载），并退出重登（company_id 取自令牌）。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_AI_PROXY_TARGET=http://127.0.0.1:8001
VITE_PAGE_AGENT_API_BASE_URL=/api/v1/page-agent
# 打印客户端安装包（精臣打印服务 / USB 驱动 / 芯烨打印代理）的云下载地址前缀，
# 与 nuomi_wms/.env 的 BAIDU_BOS_ENDPOINT 同值（同一个桶）。改后需重启 vite 才生效。
VITE_DOWNLOAD_BASE_URL=https://nuomiwms.gz.bcebos.com
# PDF 审核工作台云端地址（粘性寻址兜底源）。当前模式：PDF 链路全走本地
# （vite.config 的 PDF/knowledge 代理前缀均已指向 http://127.0.0.1:8001）。
# 云端兜底地址（https://www.aster-mindlink.cn:7779）在需要时再填回。
VITE_PDF_API_BASE=
