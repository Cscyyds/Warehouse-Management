VITE_API_BASE_URL=/
VITE_API_PROXY_TARGET=https://www.aster-mindlink.cn
# 当前模式：全线上，本地不启动任何后端。
# AI 会话/文件/ASR 走云端 AI 网关（与小程序 zhiwenServiceBaseURL 一致）。
# 需本地调试 AI 链路时改回 http://127.0.0.1:8001 并启动 Coze-Connect。
VITE_AI_PROXY_TARGET=https://www.aster-mindlink.cn:7779
VITE_PAGE_AGENT_API_BASE_URL=/api/v1/page-agent
# PDF 审核工作台当前模式：全线上——PDF 链路（上传/工作流/快照/知识库导入）
# 走同源请求，由 vite 代理 VITE_PDF_PROXY_TARGET 转发到云端 7779 网关，
# VITE_PDF_API_BASE 同步指向云端，保留直连兜底能力。
# 需本地调试时：VITE_PDF_PROXY_TARGET=http://127.0.0.1:8001、VITE_PDF_API_BASE=（置空），
# 并启动本地 Coze-Connect（8001）。
VITE_PDF_PROXY_TARGET=https://www.aster-mindlink.cn:7779
VITE_PDF_API_BASE=https://www.aster-mindlink.cn:7779
