# 本地调试配置：admin-web 通过 vite 代理访问后端
# 浏览器请求 /api/v1/* → vite dev server(127.0.0.1:3030) → 代理转发到下面的 VITE_API_PROXY_TARGET
# 接口前缀 /api/v1
VITE_API_BASE_URL=/api/v1

# 【当前】指向线上网关（2026-10-12 切换，用于在线管理端配置 TSC 打印机型号）
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 切回本地后端 nuomi_wms（127.0.0.1:8000）时改回：
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# .env 只在 vite dev server 启动时读取，改完必须重启 3030 才生效
