# 本地调试配置：admin-web 通过 vite 代理访问后端
# 浏览器请求 /api/v1/* → vite dev server(127.0.0.1:3030) → 代理转发到下面的 VITE_API_PROXY_TARGET
# 接口前缀 /api/v1
VITE_API_BASE_URL=/api/v1

# 【当前】指向本地后端（2026-11-12 切回，本地联调租户形态闭环）
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# PDF 解析后台（Coze_Connect pdf_agent）：本地默认 8001
VITE_PDF_AGENT_PROXY_TARGET=http://127.0.0.1:8001

# 切回线上网关时改回：
# VITE_API_PROXY_TARGET=https://www.aster-mindlink.cn
# .env 只在 vite dev server 启动时读取，改完必须重启 3030 才生效
