# 本地调试配置：admin-web 通过 vite 代理访问后端
# 浏览器请求 /api/v1/* → vite dev server(127.0.0.1:3030) → 代理转发到下面的 VITE_API_PROXY_TARGET
# 本地后端 nuomi_wms 默认跑在 127.0.0.1:8000，接口前缀 /api/v1
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 切回线上网关时，把上面的 VITE_API_PROXY_TARGET 改为：
# VITE_API_PROXY_TARGET=https://www.aster-mindlink.cn
